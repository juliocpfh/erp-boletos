# Copie este arquivo para ".env" (mesma pasta) e preencha. Linhas com # são comentários.
# NUNCA envie o .env para o GitHub (está no .gitignore): a chave de serviço dá acesso aos dados.

# Endereço do sistema na internet.
SITE=https://erp.ankjck.com.br

# Chave de serviço criada no painel do Cloudflare (Zero Trust → Access → Service Auth → Service Tokens).
# O passo a passo está em README.md. O Client ID também precisa estar na variável SERVICOS do Worker.
ACCESS_CLIENT_ID=
ACCESS_CLIENT_SECRET=

# A pasta do backup seguro (a mesma escolhida em Dados e backup → Backup seguro; tem o arquivo chave-do-backup.json).
# No Windows pode usar a barra normal: C:/Users/Nome/OneDrive/Backup seguro
PASTA_BACKUP=
