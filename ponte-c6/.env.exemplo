# Copie este arquivo para ".env" (mesma pasta) e preencha. Linhas com # são comentários.
# NUNCA envie o .env nem a pasta contas/ para o GitHub (estão no .gitignore).

# ---- A ponte -------------------------------------------------------------
# Porta e endereço em que a ponte escuta. Padrão: só este computador (127.0.0.1).
# Outro endereço (ex.: 0.0.0.0) exige EXPOR=1 e proteção fora da ponte (Cloudflare Access ou Tailscale): a ponte avisa em letras grandes.
PONTE_PORTA=8765
PONTE_HOST=127.0.0.1
#EXPOR=0
# Lista FIXA dos endereços do site que podem chamar a ponte (CORS), separados por vírgula. "*" nunca é aceito.
# Para usar a versão sem internet (arquivo .html aberto do disco), acrescente "null" (com cuidado: vale para qualquer arquivo local).
ORIGENS=http://localhost:8000,http://127.0.0.1:8000,https://juliocpfh.github.io
# Senha combinada com o site (Dados e backup → Banco C6 → "Senha da ponte"). Invente uma frase longa.
PONTE_SENHA=troque-esta-senha
# 1 = responde com boletos fictícios, sem falar com o banco (para testar as telas antes de ter as chaves). 0 = de verdade.
# Não pode valer com uma conta em produção: a ponte se recusa a subir.
SIMULADO=1
# Opcional: a ponte em HTTPS (certificado próprio). Em branco: HTTP simples, só neste computador.
#PONTE_HTTPS_CERT=
#PONTE_HTTPS_CHAVE=
# Nome e versão do software enviados ao C6 nos cabeçalhos partner-software-name / partner-software-version
PONTE_NOME_SOFTWARE=administracao-imoveis
PONTE_VERSAO_SOFTWARE=0.1.0

# ---- As contas -----------------------------------------------------------
# Uma conta por empresa, com o mesmo identificador cadastrado no site (Dados e backup → Banco C6 → Contas).
CONTAS=ank,jck

# Cada conta pode ter as chaves aqui (C6_<ID>_...) ou em arquivos na pasta contas/<id>/:
#   contas/ank/client_id.txt, client_secret.txt, certificado.crt, chave.key, ambiente.txt (sandbox ou producao)
# Restrinja a leitura desses arquivos ao seu usuário: Linux/macOS `chmod 600 contas/*/*`; Windows: Propriedades → Segurança (só você).
# O que estiver aqui vale primeiro. Os caminhos podem ser relativos à pasta da ponte.
C6_ANK_AMBIENTE=sandbox
C6_ANK_CLIENT_ID=
C6_ANK_CLIENT_SECRET=
C6_ANK_CERTIFICADO=contas/ank/certificado.crt
C6_ANK_CHAVE=contas/ank/chave.key
#C6_ANK_SENHA_CHAVE=
# Só se o C6 informar outro endereço (A CONFIRMAR na documentação): padrão sandbox https://baas-api-sandbox.c6bank.info e produção https://baas-api.c6bank.info
#C6_ANK_URL_BASE=

C6_JCK_AMBIENTE=sandbox
C6_JCK_CLIENT_ID=
C6_JCK_CLIENT_SECRET=
C6_JCK_CERTIFICADO=contas/jck/certificado.crt
C6_JCK_CHAVE=contas/jck/chave.key
#C6_JCK_SENHA_CHAVE=
#C6_JCK_URL_BASE=

# Pastas (opcionais): onde ficam as contas e os avisos recebidos do banco (webhook)
#PASTA_CONTAS=contas
#PASTA_NOTIFICACOES=notificacoes
# Registro de cada chamada ao banco (status e resposta), para preencher o roteiro de homologação. Vazio (PASTA_REGISTROS=) desliga.
#PASTA_REGISTROS=registros
